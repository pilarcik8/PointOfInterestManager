@startuml
!theme plain
skinparam classAttributeIconSize 0
top to bottom direction

' Definícia všetkých prvkov
class KDTree
class QTree
class HybridQTree

package "Benchmark Jadro" {
    interface IBenchmarkTree {
        + Insert(long id, double x, double y)
        + FindRange(minX, minY, maxX, maxY)
    }
    class ExternalDataTreeTester {
        + Run(CSVParser, CSVParser)
    }
}

package "Vlastné Adaptéry" {
    class OwnKdTreeAdapter
    class OwnQuadTreeAdapter
    class HybridQuadTreeAdapter
}

package "Adaptéry pre Externé Knižnice" {
    class BkdTreeAdapter
    class NetTopologySuiteKdTreeAdapter
    class NetTopologyQuadTreeAdapter
    class QuadTreeMasterAdapter
    class SpatialTreesQuadTreeAdapter
    class OmniKdTreeAdapter
}

package "Externé Knižnice" {
    class BKDTree <<external>>
    class NetTopologySuite <<external>>
    class QuadTree <<external>>
    class SpatialTrees <<external>>
    class Omni_Collections <<external>>
}

' ==========================================
' VYNÚTENIE RIADKOV (Vodorovné zarovnanie)
' ==========================================

' Riadok 1
KDTree -[hidden]right- QTree
QTree -[hidden]right- HybridQTree
HybridQTree -[hidden]right- IBenchmarkTree
IBenchmarkTree -[hidden]right- ExternalDataTreeTester

' Riadok 2
OwnKdTreeAdapter -[hidden]right- OwnQuadTreeAdapter
OwnQuadTreeAdapter -[hidden]right- HybridQuadTreeAdapter

' Riadok 3
BkdTreeAdapter -[hidden]right- NetTopologySuiteKdTreeAdapter
NetTopologySuiteKdTreeAdapter -[hidden]right- NetTopologyQuadTreeAdapter
NetTopologyQuadTreeAdapter -[hidden]right- QuadTreeMasterAdapter
QuadTreeMasterAdapter -[hidden]right- SpatialTreesQuadTreeAdapter
SpatialTreesQuadTreeAdapter -[hidden]right- OmniKdTreeAdapter

' Riadok 4
BKDTree -[hidden]right- NetTopologySuite
NetTopologySuite -[hidden]right- QuadTree
QuadTree -[hidden]right- SpatialTrees
SpatialTrees -[hidden]right- Omni_Collections

' ==========================================
' VYNÚTENIE ODSADENIA MEDZI RIADKAMI (Zvislé zarovnanie)
' ==========================================
KDTree -[hidden]down- OwnKdTreeAdapter
OwnKdTreeAdapter -[hidden]down- BkdTreeAdapter
BkdTreeAdapter -[hidden]down- BKDTree

' ==========================================
' REÁLNE VZŤAHY
' ==========================================
ExternalDataTreeTester ..> IBenchmarkTree : používa

OwnKdTreeAdapter ..|> IBenchmarkTree
OwnQuadTreeAdapter ..|> IBenchmarkTree
HybridQuadTreeAdapter ..|> IBenchmarkTree

BkdTreeAdapter ..|> IBenchmarkTree
NetTopologySuiteKdTreeAdapter ..|> IBenchmarkTree
NetTopologyQuadTreeAdapter ..|> IBenchmarkTree
QuadTreeMasterAdapter ..|> IBenchmarkTree
SpatialTreesQuadTreeAdapter ..|> IBenchmarkTree
OmniKdTreeAdapter ..|> IBenchmarkTree

OwnKdTreeAdapter ..> KDTree : obaľuje
OwnQuadTreeAdapter ..> QTree : obaľuje
HybridQuadTreeAdapter ..> HybridQTree : obaľuje

BkdTreeAdapter ..> BKDTree : obaľuje
NetTopologySuiteKdTreeAdapter ..> NetTopologySuite : obaľuje
NetTopologyQuadTreeAdapter ..> NetTopologySuite : obaľuje
QuadTreeMasterAdapter ..> QuadTree : obaľuje
SpatialTreesQuadTreeAdapter ..> SpatialTrees : obaľuje
OmniKdTreeAdapter ..> Omni_Collections : obaľuje

@enduml