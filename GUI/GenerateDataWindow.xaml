<!-- Vygenerovane / upravene pomocou AI - Kapitola 75 -->
<Window x:Class="GUI.GenerateDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generovanie POI do CSV" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Nastavenie generovania POI" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="CSV súbor:" VerticalAlignment="Center" />
        <TextBox x:Name="OutputPathBox" Grid.Row="1" Grid.Column="1" Text="generated_data.csv" />
        <Button Grid.Row="1" Grid.Column="2" Content="Vybrať priečinok" Click="ChooseFolder_Click" Margin="6,2,0,6" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Počet bodov:" VerticalAlignment="Center" />
        <TextBox x:Name="CountBox" Grid.Row="2" Grid.Column="1" Text="100" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min. zemepisná šírka:" VerticalAlignment="Center" />
        <TextBox x:Name="MinLatitudeBox" Grid.Row="3" Grid.Column="1" Text="47" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min. zemepisná dĺžka:" VerticalAlignment="Center" />
        <TextBox x:Name="MinLongitudeBox" Grid.Row="4" Grid.Column="1" Text="16" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max. zemepisná šírka:" VerticalAlignment="Center" />
        <TextBox x:Name="MaxLatitudeBox" Grid.Row="5" Grid.Column="1" Text="50" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Max. zemepisná dĺžka:" VerticalAlignment="Center" />
        <TextBox x:Name="MaxLongitudeBox" Grid.Row="6" Grid.Column="1" Text="23" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Generovať" Click="Generate_Click" IsDefault="True" MinWidth="90" />
            <Button Content="Zrušiť" Click="Cancel_Click" IsCancel="True" MinWidth="90" Margin="8,4,0,4" />
        </StackPanel>
    </Grid>
</Window>
